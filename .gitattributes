# Set default behavior to automatically normalize line endings
* text=auto

# Force these files to always be normalized and converted to LF on checkout
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Specific files
.gitignore text eol=lf
README.md text eol=lf
LICENSE text eol=lf